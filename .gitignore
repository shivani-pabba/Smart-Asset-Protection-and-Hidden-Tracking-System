# ==============================================================================
# Smart Asset Protection & Hidden Tracking System - .gitignore
# ==============================================================================

# -------------------------------------------------------------
# Operating System Files
# -------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Nn]on[Tt]racked/
desktop.ini

# -------------------------------------------------------------
# Environment & Secrets (NEVER COMMIT SENSITIVE DATA)
# -------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
key.properties
*.keystore
*.jks

# -------------------------------------------------------------
# Temporary & Backup Files
# -------------------------------------------------------------
main_backup.txt
.backup_phase1/
*.bak
*.swp
*.swo
*~
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build_report.py
make_report_part1.py

# -------------------------------------------------------------
# Node.js & Backend
# -------------------------------------------------------------
node_modules/
backend/node_modules/
backend/.env
package-lock.json

# -------------------------------------------------------------
# Flutter & Dart
# -------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
/build/
**/doc/api/
.widget_preview/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# -------------------------------------------------------------
# Android
# -------------------------------------------------------------
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
/android/app/debug
/android/app/profile
/android/app/release

# -------------------------------------------------------------
# iOS
# -------------------------------------------------------------
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile
**/ios/**/xcuserdata
**/ios/.generated/
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

# -------------------------------------------------------------
# IDE & Code Editors
# -------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.history/
*.atom/
